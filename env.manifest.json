{
  "name": "EnvDoctor Test Suite",
  "description": "Manifesto de ambiente para o projeto @felipemadson/envdoctor",
  "runtimes": [
    {
      "command": "node",
      "minVersion": "20.0.0",
      "required": true,
      "description": "Ambiente de execução JavaScript/TypeScript"
    },
    {
      "command": "npm",
      "minVersion": "9.0.0",
      "required": true,
      "description": "Gerenciador de pacotes"
    },
    {
      "command": "git",
      "required": true,
      "description": "Controle de versão"
    }
  ],
  "ports": [
    {
      "port": 3000,
      "expectedStatus": "free",
      "serviceName": "Servidor Web / Aplicação",
      "required": true
    }
  ],
  "envVars": [
    {
      "key": "PORT",
      "required": false,
      "description": "Porta padrão do servidor HTTP"
    }
  ],
  "services": []
}