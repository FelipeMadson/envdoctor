{
  "name": "EnvDoctor Test Suite",
  "description": "Manifesto de teste para validação de ambiente local",
  "runtimes": [
    {
      "command": "node",
      "minVersion": "20.0.0",
      "required": true,
      "description": "Ambiente Node.js com suporte a ESM nativo"
    },
    {
      "command": "git",
      "required": true,
      "description": "Controle de versão Git"
    }
  ],
  "ports": [
    {
      "port": 49152,
      "expectedStatus": "free",
      "serviceName": "Porta de Teste Alta (Livre)",
      "required": true
    }
  ],
  "envVars": [
    {
      "key": "NODE_ENV",
      "required": false,
      "description": "Ambiente de execução (development/test/production)"
    }
  ],
  "services": []
}
